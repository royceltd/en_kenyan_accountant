  "html": "<style>\n  .royce-doc { font-family: \"Helvetica Neue\", Arial, sans-serif; color: #1f2937; font-size: 10pt; }\n  .royce-doc h1 { font-size: 20pt; margin: 0; color: #0b3d91; }\n  .royce-doc .muted { color: #6b7280; }\n  .royce-doc table { width: 100%; border-collapse: collapse; }\n  .royce-doc .header-row td { vertical-align: top; padding-bottom: 18px; }\n  .royce-doc .title-block { text-align: right; }\n  .royce-doc .meta-table td { padding: 2px 0; }\n  .royce-doc .meta-table .label { color: #6b7280; padding-right: 10px; }\n  .royce-doc .bill-to { margin-top: 10px; margin-bottom: 16px; }\n  .royce-doc .bill-to .label { text-transform: uppercase; font-size: 8pt; letter-spacing: 0.05em; color: #6b7280; }\n  .royce-doc .items-table { margin-top: 10px; }\n  .royce-doc .items-table th {\n    background: #0b3d91; color: #fff; text-align: left; padding: 6px 8px; font-size: 9pt; font-weight: 600;\n  }\n  .royce-doc .items-table td { padding: 6px 8px; border-bottom: 1px solid #e5e7eb; }\n  .royce-doc .items-table .num { text-align: right; }\n  .royce-doc .totals-table { width: 45%; margin-left: auto; margin-top: 12px; }\n  .royce-doc .totals-table td { padding: 3px 8px; }\n  .royce-doc .totals-table .label { text-align: right; color: #6b7280; }\n  .royce-doc .totals-table .value { text-align: right; }\n  .royce-doc .totals-table .grand-total td {\n    border-top: 2px solid #0b3d91; font-weight: 700; font-size: 12pt; padding-top: 6px;\n  }\n  .royce-doc .in-words { margin-top: 4px; font-style: italic; color: #6b7280; font-size: 9pt; }\n  .royce-doc .footer { margin-top: 28px; border-top: 1px solid #e5e7eb; padding-top: 10px; font-size: 8.5pt; color: #6b7280; }\n  .royce-doc .validity-note { margin-top: 12px; font-size: 9pt; color: #9a3412; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 6px; padding: 8px 12px; }\n</style>\n\n<div class=\"royce-doc\">\n  <table class=\"header-row\">\n    <tr>\n      <td style=\"width: 55%;\">\n        <h1>{{ frappe.db.get_value(\"Company\", doc.company, \"company_name\") or doc.company }}</h1>\n        {% set kra_pin = frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\n        {% if kra_pin %}<div class=\"muted\">KRA PIN: {{ kra_pin }}</div>{% endif %}\n        {% set company_phone = frappe.db.get_value(\"Company\", doc.company, \"phone_no\") %}\n        {% if company_phone %}<div class=\"muted\">{{ company_phone }}</div>{% endif %}\n      </td>\n      <td class=\"title-block\" style=\"width: 45%;\">\n        <h1>Quotation</h1>\n        <table class=\"meta-table\" style=\"margin-left: auto;\">\n          <tr><td class=\"label\">Quotation No.</td><td>{{ doc.name }}</td></tr>\n          <tr><td class=\"label\">Date</td><td>{{ frappe.utils.formatdate(doc.transaction_date) }}</td></tr>\n          {% if doc.valid_till %}<tr><td class=\"label\">Valid Till</td><td>{{ frappe.utils.formatdate(doc.valid_till) }}</td></tr>{% endif %}\n        </table>\n      </td>\n    </tr>\n  </table>\n\n  <div class=\"bill-to\">\n    <div class=\"label\">Prepared For</div>\n    <div style=\"font-weight: 600;\">{{ doc.customer_name or doc.party_name }}</div>\n    {% if doc.address_display %}<div class=\"muted\">{{ doc.address_display }}</div>{% endif %}\n    {% if doc.contact_display %}<div class=\"muted\">{{ doc.contact_display }}</div>{% endif %}\n  </div>\n\n  <table class=\"items-table\">\n    <thead>\n      <tr>\n        <th style=\"width: 4%;\">#</th>\n        <th style=\"width: 44%;\">Item</th>\n        <th class=\"num\" style=\"width: 12%;\">Qty</th>\n        <th class=\"num\" style=\"width: 20%;\">Rate</th>\n        <th class=\"num\" style=\"width: 20%;\">Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td>\n          <div>{{ item.item_name }}</div>\n          {% if item.description and item.description != item.item_name %}\n          <div class=\"muted\" style=\"font-size: 8.5pt;\">{{ item.description }}</div>\n          {% endif %}\n        </td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(item.qty, currency=\"\") }} {{ item.uom or \"\" }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(item.rate, currency=doc.currency) }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <table class=\"totals-table\">\n    <tr><td class=\"label\">Subtotal</td><td class=\"value\">{{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}</td></tr>\n    {% for tax in doc.taxes %}\n    <tr><td class=\"label\">{{ tax.description }}</td><td class=\"value\">{{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}</td></tr>\n    {% endfor %}\n    <tr class=\"grand-total\"><td class=\"label\">Total</td><td class=\"value\">{{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}</td></tr>\n  </table>\n  <div class=\"in-words\" style=\"text-align: right;\">{{ frappe.utils.money_in_words(doc.grand_total, doc.currency) }}</div>\n\n  {% if doc.valid_till %}\n  <div class=\"validity-note\">This quotation is valid until {{ frappe.utils.formatdate(doc.valid_till) }}.</div>\n  {% endif %}\n\n  {% if doc.terms %}\n  <div style=\"margin-top: 20px;\">\n    <div class=\"bill-to label\">Terms &amp; Conditions</div>\n    <div>{{ doc.terms }}</div>\n  </div>\n  {% endif %}\n\n  <div class=\"footer\">\n    Thank you for considering us. This is a computer-generated quotation and is valid without a signature.\n  </div>\n</div>\n",
