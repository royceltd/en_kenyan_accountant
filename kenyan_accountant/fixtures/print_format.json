  "html": "<style>\n  .royce-receipt { font-family: \"Helvetica Neue\", Arial, sans-serif; color: #1f2937; font-size: 10pt; }\n  .royce-receipt h1 { font-size: 20pt; margin: 0; color: #0b3d91; }\n  .royce-receipt .muted { color: #6b7280; }\n  .royce-receipt table { width: 100%; border-collapse: collapse; }\n  .royce-receipt .header-row td { vertical-align: top; padding-bottom: 18px; }\n  .royce-receipt .title-block { text-align: right; }\n  .royce-receipt .meta-table td { padding: 2px 0; }\n  .royce-receipt .meta-table .label { color: #6b7280; padding-right: 10px; }\n  .royce-receipt .amount-box {\n    margin: 20px 0; padding: 18px 20px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px;\n    display: flex; justify-content: space-between; align-items: center;\n  }\n  .royce-receipt .amount-box .label { font-size: 12pt; font-weight: 600; color: #0b3d91; }\n  .royce-receipt .amount-box .value { font-size: 22pt; font-weight: 700; color: #0b3d91; }\n  .royce-receipt .details-table td { padding: 6px 0; border-bottom: 1px solid #e5e7eb; }\n  .royce-receipt .details-table .label { color: #6b7280; width: 40%; }\n  .royce-receipt .refs-table { margin-top: 16px; }\n  .royce-receipt .refs-table th {\n    background: #0b3d91; color: #fff; text-align: left; padding: 6px 8px; font-size: 9pt; font-weight: 600;\n  }\n  .royce-receipt .refs-table td { padding: 6px 8px; border-bottom: 1px solid #e5e7eb; }\n  .royce-receipt .refs-table .num { text-align: right; }\n  .royce-receipt .footer { margin-top: 28px; border-top: 1px solid #e5e7eb; padding-top: 10px; font-size: 8.5pt; color: #6b7280; }\n</style>\n\n<div class=\"royce-receipt\">\n  <table class=\"header-row\">\n    <tr>\n      <td style=\"width: 55%;\">\n        <h1>{{ frappe.db.get_value(\"Company\", doc.company, \"company_name\") or doc.company }}</h1>\n        {% set kra_pin = frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\n        {% if kra_pin %}<div class=\"muted\">KRA PIN: {{ kra_pin }}</div>{% endif %}\n      </td>\n      <td class=\"title-block\" style=\"width: 45%;\">\n        <h1>{{ \"Payment Receipt\" if doc.payment_type == \"Receive\" else \"Payment Voucher\" }}</h1>\n        <table class=\"meta-table\" style=\"margin-left: auto;\">\n          <tr><td class=\"label\">Receipt No.</td><td>{{ doc.name }}</td></tr>\n          <tr><td class=\"label\">Date</td><td>{{ frappe.utils.formatdate(doc.posting_date) }}</td></tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n\n  <div class=\"amount-box\">\n    <div class=\"label\">{{ \"Received From\" if doc.payment_type == \"Receive\" else \"Paid To\" }}<br>\n      <span style=\"font-weight: 700; font-size: 13pt; color: #111827;\">{{ doc.party_name }}</span>\n    </div>\n    <div class=\"value\">{{ frappe.utils.fmt_money(doc.paid_amount, currency=doc.paid_from_account_currency or None) }}</div>\n  </div>\n\n  <table class=\"details-table\">\n    <tr><td class=\"label\">Amount in Words</td><td>{{ frappe.utils.money_in_words(doc.paid_amount) }}</td></tr>\n    <tr><td class=\"label\">Mode of Payment</td><td>{{ doc.mode_of_payment or \"-\" }}</td></tr>\n    {% if doc.reference_no %}\n    <tr><td class=\"label\">Reference No.</td><td>{{ doc.reference_no }}</td></tr>\n    {% endif %}\n    {% if doc.reference_date %}\n    <tr><td class=\"label\">Reference Date</td><td>{{ frappe.utils.formatdate(doc.reference_date) }}</td></tr>\n    {% endif %}\n  </table>\n\n  {% if doc.references %}\n  <table class=\"refs-table\">\n    <thead>\n      <tr>\n        <th>Document</th>\n        <th>Type</th>\n        <th class=\"num\">Total</th>\n        <th class=\"num\">Allocated</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for ref in doc.references %}\n      <tr>\n        <td>{{ ref.reference_name }}</td>\n        <td>{{ ref.reference_doctype }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(ref.total_amount, currency=doc.paid_from_account_currency or None) }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(ref.allocated_amount, currency=doc.paid_from_account_currency or None) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  {% endif %}\n\n  <div class=\"footer\">\n    This is a computer-generated receipt and is valid without a signature.\n  </div>\n</div>\n",
