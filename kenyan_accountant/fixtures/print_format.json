  "format_data": null,
  "html": "<style>\n  .royce-invoice { font-family: \"Helvetica Neue\", Arial, sans-serif; color: #1f2937; font-size: 10pt; }\n  .royce-invoice h1 { font-size: 20pt; margin: 0; color: #0b3d91; }\n  .royce-invoice .muted { color: #6b7280; }\n  .royce-invoice table { width: 100%; border-collapse: collapse; }\n  .royce-invoice .header-row td { vertical-align: top; padding-bottom: 18px; }\n  .royce-invoice .title-block { text-align: right; }\n  .royce-invoice .meta-table td { padding: 2px 0; }\n  .royce-invoice .meta-table .label { color: #6b7280; padding-right: 10px; }\n  .royce-invoice .bill-to { margin-top: 10px; margin-bottom: 16px; }\n  .royce-invoice .bill-to .label { text-transform: uppercase; font-size: 8pt; letter-spacing: 0.05em; color: #6b7280; }\n  .royce-invoice .items-table { margin-top: 10px; }\n  .royce-invoice .items-table th {\n    background: #0b3d91; color: #fff; text-align: left; padding: 6px 8px; font-size: 9pt; font-weight: 600;\n  }\n  .royce-invoice .items-table td { padding: 6px 8px; border-bottom: 1px solid #e5e7eb; }\n  .royce-invoice .items-table .num { text-align: right; }\n  .royce-invoice .totals-table { width: 45%; margin-left: auto; margin-top: 12px; }\n  .royce-invoice .totals-table td { padding: 3px 8px; }\n  .royce-invoice .totals-table .label { text-align: right; color: #6b7280; }\n  .royce-invoice .totals-table .value { text-align: right; }\n  .royce-invoice .totals-table .grand-total td {\n    border-top: 2px solid #0b3d91; font-weight: 700; font-size: 12pt; padding-top: 6px;\n  }\n  .royce-invoice .in-words { margin-top: 4px; font-style: italic; color: #6b7280; font-size: 9pt; }\n  .royce-invoice .footer { margin-top: 28px; border-top: 1px solid #e5e7eb; padding-top: 10px; font-size: 8.5pt; color: #6b7280; }\n</style>\n\n<div class=\"royce-invoice\">\n  <table class=\"header-row\">\n    <tr>\n      <td style=\"width: 55%;\">\n        <h1>{{ frappe.db.get_value(\"Company\", doc.company, \"company_name\") or doc.company }}</h1>\n        {% set kra_pin = frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\n        {% if kra_pin %}<div class=\"muted\">KRA PIN: {{ kra_pin }}</div>{% endif %}\n        {% set company_phone = frappe.db.get_value(\"Company\", doc.company, \"phone_no\") %}\n        {% if company_phone %}<div class=\"muted\">{{ company_phone }}</div>{% endif %}\n        {% set company_email = frappe.db.get_value(\"Company\", doc.company, \"email\") %}\n        {% if company_email %}<div class=\"muted\">{{ company_email }}</div>{% endif %}\n      </td>\n      <td class=\"title-block\" style=\"width: 45%;\">\n        <h1>TAX INVOICE</h1>\n        <table class=\"meta-table\" style=\"margin-left: auto;\">\n          <tr><td class=\"label\">Invoice No.</td><td>{{ doc.name }}</td></tr>\n          <tr><td class=\"label\">Date</td><td>{{ frappe.utils.formatdate(doc.posting_date) }}</td></tr>\n          {% if doc.due_date %}<tr><td class=\"label\">Due Date</td><td>{{ frappe.utils.formatdate(doc.due_date) }}</td></tr>{% endif %}\n          {% if doc.po_no %}<tr><td class=\"label\">Customer PO</td><td>{{ doc.po_no }}</td></tr>{% endif %}\n        </table>\n      </td>\n    </tr>\n  </table>\n\n  <div class=\"bill-to\">\n    <div class=\"label\">Bill To</div>\n    <div style=\"font-weight: 600;\">{{ doc.customer_name }}</div>\n    {% if doc.address_display %}<div class=\"muted\">{{ doc.address_display }}</div>{% endif %}\n    {% set customer_tax_id = frappe.db.get_value(\"Customer\", doc.customer, \"tax_id\") %}\n    {% if customer_tax_id %}<div class=\"muted\">KRA PIN: {{ customer_tax_id }}</div>{% endif %}\n  </div>\n\n  <table class=\"items-table\">\n    <thead>\n      <tr>\n        <th style=\"width: 4%;\">#</th>\n        <th style=\"width: 40%;\">Item</th>\n        <th class=\"num\" style=\"width: 10%;\">Qty</th>\n        <th class=\"num\" style=\"width: 16%;\">Rate</th>\n        <th class=\"num\" style=\"width: 15%;\">VAT</th>\n        <th class=\"num\" style=\"width: 15%;\">Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td>\n          <div>{{ item.item_name }}</div>\n          {% if item.description and item.description != item.item_name %}\n          <div class=\"muted\" style=\"font-size: 8.5pt;\">{{ item.description }}</div>\n          {% endif %}\n        </td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(item.qty, currency=\"\") }} {{ item.uom or \"\" }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(item.rate, currency=doc.currency) }}</td>\n        <td class=\"num\">{{ item.item_tax_template or \"-\" }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <table class=\"totals-table\">\n    <tr><td class=\"label\">Subtotal</td><td class=\"value\">{{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}</td></tr>\n    {% for tax in doc.taxes %}\n    <tr><td class=\"label\">{{ tax.description }}</td><td class=\"value\">{{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}</td></tr>\n    {% endfor %}\n    <tr class=\"grand-total\"><td class=\"label\">Total</td><td class=\"value\">{{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}</td></tr>\n  </table>\n  <div class=\"in-words\" style=\"text-align: right;\">{{ frappe.utils.money_in_words(doc.grand_total, doc.currency) }}</div>\n\n  {% if doc.terms %}\n  <div style=\"margin-top: 20px;\">\n    <div class=\"bill-to label\">Terms &amp; Conditions</div>\n    <div>{{ doc.terms }}</div>\n  </div>\n  {% endif %}\n\n  <div class=\"footer\">\n    Thank you for your business. This is a computer-generated tax invoice and is valid without a signature.\n  </div>\n</div>\n",
